    {
        "id": "f10_inyectar_carga",
        "type": "function",
        "z": "eb1363c5970b07e4",
        "name": "Restaurar Memoria e Inundar Red",
        "func": "let dataObra = JSON.parse(msg.payload);\n\nif (dataObra && dataObra.configuracion_nodos) {\n    // 1. Restaurar memoria global\n    global.set('pipea_nodos', dataObra.configuracion_nodos);\n    \n    let listaNodos = Object.values(dataObra.configuracion_nodos);\n    let mensajesMqtt = [];\n    \n    // 2. Construir los mensajes MQTT de configuración\n    listaNodos.forEach(nodo => {\n        mensajesMqtt.push({\n            topic: `pipea/config/${nodo.id}`,\n            payload: {\n                personaje_asignado: nodo.personaje_asignado,\n                campos_actualizados: nodo.campos_configurables\n            }\n        });\n    });\n    \n    // 3. Enviamos un solo objeto consolidado a la UI para evitar saturarla\n    let mensajeUI = { \n        payload: { \n            conectados: listaNodos, \n            historial: Object.values(global.get('pipea_historial') || {}) \n        } \n    };\n    \n    // IMPORTANTE: Retornamos primero el mensaje de UI y los MQTT ordenados\n    return [ mensajeUI, mensajesMqtt ];\n}\nreturn null;\n",
