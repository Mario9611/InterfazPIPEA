        "format": "<template>\n  <v-card class=\"pa-4\" outlined min-height=\"500\" style=\"background-color: #ffffff;\">\n    <!-- Encabezado Principal -->\n    <v-card-title class=\"d-flex justify-space-between align-center border-b pb-2 mb-4\">\n      <div class=\"text-h5 font-weight-bold text-blue-darken-3\">\n        🎬 Director de Puestas en Escena PIPEA\n      </div>\n      <v-chip color=\"primary\" variant=\"elevated\" prepend-icon=\"mdi-clapperboard\">\n        Modo Macro-Control\n      </v-chip>\n    </v-card-title>\n\n    <!-- CONTROL DE ESCENAS GLOBALES -->\n    <v-row class=\"mb-4\">\n      <v-col cols=\"12\">\n        <v-card variant=\"flat\" class=\"pa-3\" style=\"background-color: #f1f8ff; border: 1px solid #b3d7ff;\">\n          <div class=\"text-subtitle-1 font-weight-bold mb-2 text-blue-darken-4\">\n            ✨ Captura Dinámica de Estado Escénico\n          </div>\n          <v-row density=\"compact\" class=\"align-center\">\n            <v-col cols=\"12\" sm=\"7\">\n              <v-text-field\n                v-model=\"nombreEscena\"\n                label=\"Identificador de la Escena / Cue (ej: acto_1_atardecer)\"\n                variant=\"outlined\"\n                density=\"compact\"\n                hide-details\n                prepend-inner-icon=\"mdi-theater\"\n              ></v-text-field>\n            </v-col>\n            <v-col cols=\"12\" sm=\"5\" class=\"d-flex ga-2\">\n              <v-btn color=\"success\" block size=\"large\" prepend-icon=\"mdi-camera\" @click=\"capturarEstadoGlobal\">\n                Capturar Escena\n              </v-btn>\n            </v-col>\n          </v-row>\n        </v-card>\n      </v-col>\n    </v-row>\n\n    <v-divider class=\"my-2\"></v-divider>\n\n    <!-- VISTA PREVIA DE LOS PARÁMETROS ACTUALES DE LA RED -->\n    <div class=\"text-subtitle-2 font-weight-bold mb-3 text-grey-darken-3\">\n      🎛️ Monitoreo de Parámetros Activos en la Red (Fotografía en Vivo)\n    </div>\n\n    <v-alert v-if=\"!msg?.payload?.conectados || msg.payload.conectados.length === 0\" type=\"info\" variant=\"tonal\">\n      No hay nodos activos en la red para capturar configuraciones en este momento.\n    </v-alert>\n\n    <v-row v-else>\n      <v-col cols=\"12\" md=\"6\" v-for=\"nodo in msg.payload.conectados\" :key=\"nodo.id\">\n        <v-card variant=\"outlined\" class=\"pa-3 mb-2\" style=\"border-radius: 6px;\">\n          <div class=\"d-flex justify-space-between align-center mb-2\">\n            <span class=\"font-weight-bold text-primary\">{{ nodo.id }}</span>\n            <v-chip size=\"x-small\" color=\"secondary\">{{ nodo.tipo_nodo }}</v-chip>\n          </div>\n          \n          <!-- Lista compacta de sus variables actuales -->\n          <div v-for=\"campo in nodo.campos_configurables\" :key=\"campo.clave\" class=\"text-caption d-flex justify-space-between py-1 border-b-dashed\">\n            <span class=\"text-grey-darken-1\">{{ campo.clave }}:</span>\n            <span class=\"font-weight-bold\" :style=\"{ color: campo.tipo === 'color_rgb' ? campo.defecto : 'inherit' }\">\n              {{ campo.defecto }}\n            </span>\n          </div>\n        </v-card>\n      </v-col>\n    </v-row>\n  </v-card>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      nombreEscena: 'escena_inicio_ucr'\n    }\n  },\n  methods: {\n    capturarEstadoGlobal() {\n      // Al presionar el botón, despachamos una orden con el nombre de la escena\n      this.send({\n        action: 'guardar_snapshot_global',\n        nombre_escena: this.nombreEscena\n      });\n    }\n  }\n}\n</script>\n",
