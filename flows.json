    {
        "id": "f2_procesar_registro",
        "type": "function",
        "z": "eb1363c5970b07e4",
        "name": "Gestor de Memoria Global",
        "func": "// Inicializar la base de datos de nodos en el contexto global si no existe\nlet mapaNodos = global.get('pipea_nodos') || {};\nlet historialNodos = global.get('pipea_historial') || {};\n\n// Extraer el ID del nodo desde el tópico (pipea/registro/ID)\nlet topicParts = msg.topic.split('/');\nlet nodoId = topicParts[2];\n\nlet payload = msg.payload;\n\n// Si el payload está vacío o tiene estado offline (LWT o desconexión)\nif (!payload || payload.estado === \"offline\") {\n    if (mapaNodos[nodoId]) {\n        // Pasar a historial de desconectados guardando sus últimas capacidades\n        historialNodos[nodoId] = {\n            ...mapaNodos[nodoId],\n            ultimo_visto: new Date().toLocaleTimeString(),\n            conectado: false\n        };\n        delete mapaNodos[nodoId];\n    }\n} else {\n    // Nodo Online: Registrar o actualizar capacidades\n    mapaNodos[nodoId] = {\n        ...payload,\n        ultimo_visto: new Date().toLocaleTimeString(),\n        conectado: true\n    };\n    \n    // Si existía en el historial, lo removemos de ahí porque volvió a conectarse\n    if (historialNodos[nodoId]) {\n        delete historialNodos[nodoId];\n    }\n}\n\n// Guardar los cambios de vuelta en la memoria global de Node-RED\nglobal.set('pipea_nodos', mapaNodos);\nglobal.set('pipea_historial', historialNodos);\n\n// Enviar los datos consolidados hacia la interfaz visual\nmsg.payload = {\n    conectados: Object.values(mapaNodos),\n    historial: Object.values(historialNodos)\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 160,
        "wires": [
            [
                "f3_debug_registro",
                "5ea165f2e6429c1b",
                "748bf7aab34aba95"
            ]
        ]
    },
