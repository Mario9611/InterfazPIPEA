    {
        "id": "5ea165f2e6429c1b",
        "type": "ui-template",
        "z": "eb1363c5970b07e4",
        "group": "4df33a8f9b357f86",
        "page": "",
        "ui": "",
        "name": "Panel izquierdo",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <v-card class=\"pa-2\" outlined min-height=\"400\" style=\"background-color: #f8f9fa;\">\n    <v-card-title class=\"text-subtitle-1 font-weight-bold primary--text\">\n      🔴 Red PIPEA Escénica\n    </v-card-title>\n    <v-divider></v-divider>\n\n    <!-- SECCIÓN DE NODOS ACTIVOS -->\n    <v-list subheader flat transparent>\n      <v-list-subheader class=\"font-weight-bold text-success\">\n        Conectados en Vivo ({{ msg?.payload?.conectados?.length || 0 }})\n      </v-list-subheader>\n      \n      <!-- Agregamos @click y estilo de cursor interactivo -->\n      <v-list-item \n        v-for=\"nodo in msg?.payload?.conectados\" \n        :key=\"nodo.id\" \n        class=\"mb-1\" \n        style=\"background-color: #e8f5e9; border-left: 5px solid #4caf50; border-radius: 4px; cursor: pointer;\"\n        @click=\"seleccionarNodo(nodo)\"\n      >\n        <template v-slot:prepend>\n          <v-icon color=\"success\">mdi-wifi</v-icon>\n        </template>\n        <v-list-item-title class=\"font-weight-bold\">{{ nodo.id }}</v-list-item-title>\n        <v-list-item-subtitle>\n          Tipo: {{ nodo.tipo_nodo }} | Personaje: <v-chip size=\"x-small\" color=\"success\" variant=\"flat\">{{ nodo.personaje_asignado || 'Ninguno' }}</v-chip>\n        </v-list-item-subtitle>\n      </v-list-item>\n\n      <v-list-item v-if=\"!msg?.payload?.conectados || msg?.payload?.conectados?.length === 0\">\n        <v-list-item-title class=\"text-muted text-caption italic\">Esperando nacimiento de nodos...</v-list-item-title>\n      </v-list-item>\n    </v-list>\n\n    <v-divider class=\"my-2\"></v-divider>\n\n    <!-- SECCIÓN DE HISTORIAL / DESCONECTADOS -->\n    <v-list subheader flat transparent>\n      <v-list-subheader class=\"font-weight-bold text-grey\">\n        Historial / Alerta Desconectados\n      </v-list-subheader>\n      \n      <!-- Agregamos @click y estilo de cursor interactivo para el historial -->\n      <v-list-item \n        v-for=\"nodo in msg?.payload?.historial\" \n        :key=\"nodo.id\" \n        class=\"mb-1\" \n        style=\"background-color: #f5f5f5; border-left: 5px solid #9e9e9e; border-radius: 4px; opacity: 0.7; cursor: pointer;\"\n        @click=\"seleccionarNodo(nodo)\"\n      >\n        <template v-slot:prepend>\n          <v-icon color=\"grey\">mdi-wifi-off</v-icon>\n        </template>\n        <v-list-item-title class=\"text-grey-darken-1\">{{ nodo.id }}</v-list-item-title>\n        <v-list-item-subtitle class=\"text-caption\">\n          Última vez visto: {{ nodo.ultimo_visto }}\n        </v-list-item-subtitle>\n      </v-list-item>\n\n      <v-list-item v-if=\"!msg?.payload?.historial || msg?.payload?.historial?.length === 0\">\n        <v-list-item-title class=\"text-muted text-caption\">Sin alertas de caída de red.</v-list-item-title>\n      </v-list-item>\n    </v-list>\n  </v-card>\n</template>\n\n<script>\nexport default {\n  methods: {\n    seleccionarNodo(nodoData) {\n      // Esta función nativa de Dashboard 2.0 transmite los datos del nodo clickeado directamente hacia la salida del bloque\n      this.send({\n        payload: nodoData\n      });\n    }\n  }\n}\n</script>",
