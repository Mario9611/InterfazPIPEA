    {
        "id": "f7_logica_archivos",
        "type": "function",
        "z": "eb1363c5970b07e4",
        "name": "Procesador de Archivo",
        "func": "// Validar que el mensaje traiga una acción de la interfaz\nif (!msg.payload || typeof msg.payload !== 'object') {\n    return null; \n}\n\nlet accion = msg.payload.action;\nlet nombreEscena = msg.payload.nombre_escena || \"escena_default\";\n\n// Limpiar el nombre para evitar caracteres extraños en el archivo de la UCR\nnombreEscena = nombreEscena.replace(/[^a-z0-9_]/gi, '_').toLowerCase();\n\n// Ruta del archivo JSON dinámico basado en la escena capturada\nmsg.filename = `obra_pipea_${nombreEscena}.json`;\n\nif (accion === 'guardar_snapshot_global') {\n    // Tomamos la fotografía completa de la memoria global de todos los nodos conectados\n    let mapaNodos = global.get('pipea_nodos') || {};\n    \n    msg.payload = {\n        metadatos: {\n            tipo_registro: \"Snapshot Global de Escena\",\n            identificador_cue: msg.payload.nombre_escena,\n            fecha_captura: new Date().toISOString()\n        },\n        configuracion_nodos_capturados: mapaNodos\n    };\n    \n    // Salida 1: Envía el archivo directo al nodo 'Escribir JSON'\n    return [msg, null];\n} \n\nreturn null;\n",
